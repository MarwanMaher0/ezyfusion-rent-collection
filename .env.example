# Copy to .env.local:  cp .env.example .env.local
# Supabase values come from `npx supabase status -o env` (local stack started by `npx supabase start`).
# The values below are the Supabase CLI's fixed local defaults; replace them if your status output differs.

# API_URL from `npx supabase status -o env`
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# PUBLISHABLE_KEY from `npx supabase status -o env` (safe for the browser; RLS applies)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
# SECRET_KEY from `npx supabase status -o env` (server only: seed script + signed slip URLs; never sent to the browser)
SUPABASE_SECRET_KEY=sb_secret_N7UND0UgjKTVK-Uodkm0Hg_xSvEMPvz
# DB_URL from `npx supabase status -o env` (Prisma connects as the postgres owner)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Same as DATABASE_URL locally (no pooler); used by the Prisma CLI (db pull)
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Shared HMAC key for the payment gateway webhook (any random string; generate with `openssl rand -hex 32`)
GATEWAY_X_SIGNATURE_KEY=test_x_signature_key
# Password shared by every seeded account (npm run seed)
SEED_PASSWORD="RentDemo#2026"
# Base URL the test suite calls (dev server started with `npm run dev -- -p 3000`)
TEST_BASE_URL=http://127.0.0.1:3000
